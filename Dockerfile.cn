# 本地构建用。前端由宿主机先构建好（见下方说明），本文件只负责编译 Go 后端。
#   1) cd web/default && npm install --registry=https://registry.npmmirror.com
#      DISABLE_ESLINT_PLUGIN=true CI=false ./node_modules/.bin/react-scripts build
#      rm -rf ../build/default && mv build ../build/default
#   2) docker build --progress=plain -f Dockerfile.cn -t one-api:local .
# 与根目录 Dockerfile 的差异：apk / go module 走国内镜像源。
FROM golang:alpine AS builder

RUN sed -i 's|dl-cdn.alpinelinux.org|mirrors.aliyun.com|g' /etc/apk/repositories

RUN apk add --no-cache \
    gcc \
    musl-dev \
    sqlite-dev \
    build-base

ENV GO111MODULE=on \
    CGO_ENABLED=1 \
    GOOS=linux \
    GOPROXY=https://goproxy.cn,direct \
    GOSUMDB=off

WORKDIR /build

ADD go.mod go.sum ./
RUN go mod download

COPY . .

RUN go build -trimpath -ldflags "-s -w -X 'github.com/songquanpeng/one-api/common.Version=$(cat VERSION)' -linkmode external -extldflags '-static'" -o one-api

FROM alpine:latest

RUN sed -i 's|dl-cdn.alpinelinux.org|mirrors.aliyun.com|g' /etc/apk/repositories && \
    apk add --no-cache ca-certificates tzdata

COPY --from=builder /build/one-api /

EXPOSE 3000
WORKDIR /data
ENTRYPOINT ["/one-api"]